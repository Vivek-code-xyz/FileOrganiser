{
  "name": "smart-file-organiser",
  "version": "1.0.0",
  "description": "A local desktop application that organizes files by extension.",
  "main": "electron/main.js", 
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chokidar": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smartfileorganizer.app",
    "productName": "Smart File Organizer",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "removePackageScripts": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
